<Window x:Class="PotatoDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="土豆下载器" Icon="Assets/PotatoDM.ico" Height="690" Width="1120"
        MinHeight="520" MinWidth="900" WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="13,7"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#FFF0CF" Margin="0,0,12,0">
                        <TextBlock Text="🥔" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="土豆下载器" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="多连接下载加速与浏览器接管" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="浏览器集成" Click="OnBrowserIntegration" Margin="0,0,8,0"/>
                    <Button Content="设置" Click="OnSettings"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16,14,16,10" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="＋ 新建下载" Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                <WrapPanel>
                    <Button Content="暂停" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="继续" Command="{Binding ResumeCommand}" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="重新开始" Command="{Binding RestartCommand}" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="移除" Command="{Binding RemoveCommand}" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="打开文件" Command="{Binding OpenFileCommand}" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" Style="{StaticResource ToolbarButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,14" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEAE3"
                          BorderThickness="0" RowHeight="70" ColumnHeaderHeight="42"
                          SelectionMode="Single" SelectionUnit="FullRow" RowBackground="White"
                          AlternatingRowBackground="#FCFBF8" MouseDoubleClick="OnGridDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#FAF8F4"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="文件" Width="*" MinWidth="250">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Margin="12,6" ToolTip="{Binding TargetPath}">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TransferredText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="进度" Width="250">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Margin="12,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SegmentSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding PercentValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,3,0,0"
                                                 Foreground="{StaticResource BrandBrush}" Background="#EEEAE3" BorderThickness="0"/>
                                    <ItemsControl ItemsSource="{Binding SegmentProgresses}" Height="7" Margin="0,5,0,0"
                                                  AutomationProperties.Name="各分段实时进度">
                                        <ItemsControl.Style><Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasSegmentProgress}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></ItemsControl.Style>
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Margin="0,0,2,0">
                                                <Border.ToolTip><ToolTip>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="序号 "/><TextBlock Text="{Binding DisplayIndex}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Percent, StringFormat={}{0:0.0}%}" Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                </ToolTip></Border.ToolTip>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="7"
                                                             Foreground="{StaticResource BrandDarkBrush}" Background="#EEEAE3" BorderThickness="0"/>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="110" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="剩余" Binding="{Binding EtaText}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="连接" Binding="{Binding ActiveConnections}" Width="70" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="状态" Width="100">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Background="#FFF5DD" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StateText}" ToolTip="{Binding Error}" Foreground="{StaticResource BrandDarkBrush}"/>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Jobs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <TextBlock Text="🥔" FontSize="38" HorizontalAlignment="Center"/>
                    <TextBlock Text="还没有下载任务" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="新建任务，或从浏览器把下载交给土豆下载器" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="双击已完成任务可打开文件" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
