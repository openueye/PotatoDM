<Window x:Class="PotatoDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PotatoDM.AppCore.Models;assembly=PotatoDM.AppCore"
        xmlns:vm="clr-namespace:PotatoDM.AppCore.Job;assembly=PotatoDM.AppCore"
        xmlns:controls="clr-namespace:PotatoDM.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="土豆下载器" Icon="Assets/PotatoDM.ico" Height="760" Width="1180"
        MinHeight="600" MinWidth="850" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnWindowClosing" PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        WindowStyle="None"
        Style="{StaticResource AppWindow}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}" />
        <Style x:Key="CaptionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrandBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource StateNeutralBackgroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Probing}">
                    <Setter Property="Background" Value="{DynamicResource StateInfoBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Downloading}">
                    <Setter Property="Background" Value="{DynamicResource StateInfoBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Paused}">
                    <Setter Property="Background" Value="{DynamicResource StateWarningBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Completed}">
                    <Setter Property="Background" Value="{DynamicResource StateSuccessBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Failed}">
                    <Setter Property="Background" Value="{DynamicResource StateErrorBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource StateNeutralForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Probing}">
                    <Setter Property="Foreground" Value="{DynamicResource StateInfoForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Downloading}">
                    <Setter Property="Foreground" Value="{DynamicResource StateInfoForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Paused}">
                    <Setter Property="Foreground" Value="{DynamicResource StateWarningForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Completed}">
                    <Setter Property="Foreground" Value="{DynamicResource StateSuccessForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource StateErrorForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InlineError" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource StateErrorForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:DownloadJobState.Failed}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
            Background="{DynamicResource PageBrush}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Unified toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFC45C" Offset="0"/>
                                <GradientStop Color="#FF9F0A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="↓" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandOnBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="土豆下载器" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,140,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="OnSettings" Style="{StaticResource FlatButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                Content="&#xE713;" Padding="10,7" Margin="0,0,12,0"
                                ToolTip="设置" AutomationProperties.Name="设置"/>
                        <Button Content="＋ 新建下载(_N)" Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="15,8"/>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize"
                            ToolTip="最小化" AutomationProperties.Name="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" Style="{StaticResource CaptionGlyph}" />
                    </Button>
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}"
                            Click="OnMaximizeRestore" ToolTip="最大化" AutomationProperties.Name="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource CaptionGlyph}" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseWindow"
                            ToolTip="关闭" AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource CaptionGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Source list -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="资料库" Margin="16,16,10,6" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"/>
                <ListBox x:Name="FilterList"
                         ItemsSource="{Binding Filters}"
                         SelectedValuePath="Key"
                         SelectedValue="{Binding Filter, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         AutomationProperties.Name="任务筛选">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}"
                                           FontSize="14" Width="22" Text="&#xE8A9;" />
                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Key}" Value="{x:Static vm:JobFilter.Downloading}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE896;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Key}" Value="{x:Static vm:JobFilter.Completed}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Key}" Value="{x:Static vm:JobFilter.Failed}">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterTitle}" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding VisibleCountText}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Width="270" Height="34" CornerRadius="9"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0,6,0,0"
                                     FontSize="12.5" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="搜索任务"
                                     ToolTip="按文件名或 URL 过滤（Ctrl+F）"/>
                            <TextBlock Text="搜索文件名或 URL"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                <Button Content="暂停(_P)" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButton}"/>
                <Button Content="继续(_R)" Command="{Binding ResumeCommand}" Style="{StaticResource ToolbarButton}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="6,0,6,6" Margin="0,0,0,16">
                <Grid>
                    <DataGrid x:Name="JobsGrid" ItemsSource="{Binding FilteredJobs}"
                              SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0"
                              RowHeight="62" ColumnHeaderHeight="32"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              RowBackground="Transparent"
                              AutomationProperties.Name="下载任务列表"
                              SelectionChanged="OnSelectionChanged"
                              PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                              MouseDoubleClick="OnGridDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}" />
                        </DataGrid.Resources>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开文件(_O)" Command="{Binding OpenFileCommand}"/>
                                <MenuItem Header="打开文件夹(_F)" Command="{Binding OpenFolderCommand}"/>
                                <MenuItem Header="复制链接(_C)" Command="{Binding CopyUrlCommand}"/>
                                <Separator/>
                                <MenuItem Header="暂停(_P)" Command="{Binding PauseCommand}"/>
                                <MenuItem Header="继续(_R)" Command="{Binding ResumeCommand}"/>
                                <MenuItem Header="{Binding SelectedJob.RestartLabel, TargetNullValue=重新开始}" Command="{Binding RestartCommand}"/>
                                <Separator/>
                                <MenuItem Header="移除(_D)" Command="{Binding RemoveCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="RowChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Margin="4,1"
                                                    SnapsToDevicePixels="True">
                                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                                    <Setter TargetName="RowChrome" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文件" Width="*" MinWidth="180" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="10,5" ToolTip="{Binding TargetPath}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TransferredText}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding FailureSummary}" Style="{StaticResource InlineError}" ToolTip="{Binding Error}"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="进度" Width="150" SortMemberPath="PercentValue">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding PercentValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,3,0,0"
                                                     IsIndeterminate="{Binding IsFinalizing}"
                                                     Foreground="{DynamicResource BrandBrush}"
                                                     Background="{DynamicResource ProgressTrackBrush}"
                                                     BorderThickness="0"
                                                     AutomationProperties.Name="{Binding DisplayName, StringFormat=下载进度 {0}}"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="92"
                                                SortMemberPath="BytesPerSecond" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Header="状态" Width="112" SortMemberPath="StateText">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border Style="{StaticResource StatePill}">
                                        <TextBlock Text="{Binding StateText}"
                                                   Style="{StaticResource StatePillText}"
                                                   ToolTip="{Binding Error}"/>
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasVisibleJobs}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <Border Width="56" Height="56" CornerRadius="28"
                                Background="{DynamicResource SelectionBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="↓" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding EmptyStateText}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Button x:Name="RegistryWarning" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed"
                Content="任务列表未保存，重启后可能丢失。点击重试保存" Click="OnRetryRegistrySave"
                Foreground="{DynamicResource StateErrorForegroundBrush}" Padding="8"/>
        <Button x:Name="BatchProbeButton" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed"
                Click="OnCancelBatchProbe" Padding="8"/>
        <Border x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" Height="36"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusSummary}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" FontSize="11" Margin="18,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>
        </Grid>
    </Border>
</Window>
