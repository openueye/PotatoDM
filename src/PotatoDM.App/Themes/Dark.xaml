<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrandBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#FFC46B" />
    <SolidColorBrush x:Key="BrandOnBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB340" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E88A00" />
    <SolidColorBrush x:Key="PageBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#242426" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#202022" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A1A1A6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A2A12" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#48484A" />
    <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#3A2A12" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5E" />
    <SolidColorBrush x:Key="ReadOnlyInputBrush" Color="#242426" />

    <SolidColorBrush x:Key="StateNeutralBackgroundBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="StateNeutralForegroundBrush" Color="#A1A1A6" />
    <SolidColorBrush x:Key="StateInfoBackgroundBrush" Color="#102A43" />
    <SolidColorBrush x:Key="StateInfoForegroundBrush" Color="#64B5FF" />
    <SolidColorBrush x:Key="StateSuccessBackgroundBrush" Color="#12301E" />
    <SolidColorBrush x:Key="StateSuccessForegroundBrush" Color="#30D158" />
    <SolidColorBrush x:Key="StateWarningBackgroundBrush" Color="#3A2A12" />
    <SolidColorBrush x:Key="StateWarningForegroundBrush" Color="#FFC46B" />
    <SolidColorBrush x:Key="StateErrorBackgroundBrush" Color="#3A1D1D" />
    <SolidColorBrush x:Key="StateErrorForegroundBrush" Color="#FF6961" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2C2C2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202022" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF9F0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D1D1F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C2C2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F5F5F7" />
</ResourceDictionary>
