<Application x:Class="PotatoDM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#E39A18" />
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#A96308" />
        <SolidColorBrush x:Key="PageBrush" Color="#F6F4EF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E0D7" />
        <SolidColorBrush x:Key="TextBrush" Color="#24221F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#77716A" />

        <!-- State colours are semantic: the status pill and the failed-row text
             both read them, so a future dark theme only has to replace these. -->
        <SolidColorBrush x:Key="StateNeutralBackgroundBrush" Color="#F1F0EC" />
        <SolidColorBrush x:Key="StateNeutralForegroundBrush" Color="#5B6573" />
        <SolidColorBrush x:Key="StateInfoBackgroundBrush" Color="#E8F1FF" />
        <SolidColorBrush x:Key="StateInfoForegroundBrush" Color="#1B4F9C" />
        <SolidColorBrush x:Key="StateSuccessBackgroundBrush" Color="#E7F5EC" />
        <SolidColorBrush x:Key="StateSuccessForegroundBrush" Color="#1E7A3C" />
        <SolidColorBrush x:Key="StateWarningBackgroundBrush" Color="#FFF5DD" />
        <SolidColorBrush x:Key="StateWarningForegroundBrush" Color="#A96308" />
        <SolidColorBrush x:Key="StateErrorBackgroundBrush" Color="#FDECEC" />
        <SolidColorBrush x:Key="StateErrorForegroundBrush" Color="#B3261E" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PageBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="#201506" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
