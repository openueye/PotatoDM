<Window x:Class="PotatoDM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 土豆下载器" Width="760" Height="620"
        MinWidth="700" MinHeight="520"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrandBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource StateNeutralBackgroundBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Margin="18,18,10,12" />
                <ListBox x:Name="SectionList"
                         SelectedIndex="0"
                         SelectionChanged="OnSectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         AutomationProperties.Name="设置分类">
                    <ListBoxItem AutomationProperties.Name="通用">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                            <TextBlock Text="通用" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="下载">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" />
                            <TextBlock Text="下载" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="浏览器接管">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" />
                            <TextBlock Text="浏览器接管" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="关于">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" />
                            <TextBlock Text="关于" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,10">
            <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="通用" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="主题" Width="110" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeBox" Width="140" DisplayMemberPath="Value"
                                          SelectedValuePath="Key" AutomationProperties.Name="主题" />
                            </StackPanel>
                            <CheckBox x:Name="CloseToTrayBox" Content="关闭主窗口时最小化到托盘" Margin="0,14,0,0" />
                            <CheckBox x:Name="StartMinimizedBox" Content="启动后静默进入托盘" Margin="0,12,0,0" />
                            <CheckBox x:Name="LaunchAtStartupBox" Content="登录 Windows 后自动启动" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="快捷方式" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="创建桌面快捷方式(_D)" Click="OnCreateDesktopShortcut" Margin="0,0,8,0" />
                            <Button Content="添加到开始菜单(_S)" Click="OnCreateStartMenuShortcut" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DownloadPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="下载" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="目录与连接" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="默认下载目录" Width="110" VerticalAlignment="Center" />
                                <TextBox x:Name="DownloadFolderBox" Width="280" VerticalAlignment="Center"
                                         AutomationProperties.Name="默认下载目录" />
                                <Button Content="浏览…(_B)" Click="OnBrowseDownloadFolder" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="AutomaticBox" Content="自动选择连接数" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="连接数" Width="110" VerticalAlignment="Center" />
                                <ComboBox x:Name="ConnectionsBox" Width="100" AutomationProperties.Name="连接数" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="同时下载任务数" Width="120" VerticalAlignment="Center" />
                                <ComboBox x:Name="JobLimitBox" Width="100" AutomationProperties.Name="同时下载任务数" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="全局限速" Width="110" VerticalAlignment="Center" />
                                <TextBox x:Name="SpeedLimitBox" Width="100" VerticalAlignment="Center"
                                         AutomationProperties.Name="全局限速"
                                         ToolTip="单位 KiB/s；0 表示不限速。" />
                                <TextBlock Text="KiB/s" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="ProxyBox" Content="使用系统代理" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Expander Header="高级" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="每任务连接上限" Width="120" VerticalAlignment="Center" />
                                    <ComboBox x:Name="PerJobLimitBox" Width="100" AutomationProperties.Name="每任务连接上限"
                                              ToolTip="单个任务同时建立的连接上限，与连接数取较小者。" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="ffmpeg 路径" Width="110" VerticalAlignment="Center" />
                                    <TextBox x:Name="FfmpegPathBox" Width="280" VerticalAlignment="Center"
                                             AutomationProperties.Name="ffmpeg 路径"
                                             ToolTip="留空则从 PATH 查找；仅合并分离的音视频轨时需要。" />
                                    <Button Content="浏览…(_B)" Click="OnBrowseFfmpeg" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="DynamicSegmentsBox" Content="动态段拆分（实验）" Margin="0,14,0,0" />
                                <CheckBox x:Name="SparseFileBox" Content="稀疏工作文件（实验）" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BrowserPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="浏览器接管" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="让 Chrome / Edge 的下载交给土豆下载器"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock Text="安装和卸载会立即生效；其他设置需要点击保存。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Border x:Name="BrowserStatusPill" Style="{StaticResource StatusPill}">
                                <TextBlock x:Name="BrowserStatusPillText" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="BrowserStatusText" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="BrowserDetectedText" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="BrowserWarningText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontSize="11" Visibility="Collapsed"
                                       Foreground="{DynamicResource StateWarningForegroundBrush}" />
                            <TextBlock x:Name="BrowserStepText" Margin="0,10,0,0" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="安装 / 修复(_I)" Click="OnBrowserInstall"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button x:Name="ChromeButton" Content="打开 Chrome 扩展页"
                                        Click="OnOpenChrome" Margin="0,0,8,8" />
                                <Button x:Name="EdgeButton" Content="打开 Edge 扩展页"
                                        Click="OnOpenEdge" Margin="0,0,8,8" />
                                <Button Content="卸载(_U)" Click="OnBrowserUninstall" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Expander Header="高级" Margin="0,16,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="扩展 ID" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExtensionIdBox" IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyInputBrush}"
                                             AutomationProperties.Name="扩展 ID" />
                                    <Button Grid.Column="1" Content="复制(_C)" Click="OnCopyExtensionId"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="扩展目录" FontSize="11" Margin="0,12,0,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChromiumPathBox" IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyInputBrush}"
                                             AutomationProperties.Name="扩展目录" />
                                    <Button Grid.Column="1" Content="复制(_C)" Click="OnCopyChromiumPath"
                                            Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="打开(_O)" Click="OnOpenExtensionFolder"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="宿主清单" FontSize="11" Margin="0,12,0,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ManifestPathBox" IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyInputBrush}"
                                             AutomationProperties.Name="宿主清单路径" />
                                    <Button Grid.Column="1" Content="复制(_C)" Click="OnCopyManifestPath"
                                            Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="24" FontWeight="Bold" />
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="土豆下载器" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="MIT 许可。第三方组件声明见安装目录 THIRD-PARTY-NOTICES.md。"
                                       Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消(_C)" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="保存(_S)" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="OnSave" Padding="18,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
