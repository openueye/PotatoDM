<Window x:Class="PotatoDM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 土豆下载器" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="下载行为" Margin="0,22,0,10" FontWeight="SemiBold"/>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="默认下载目录" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="DownloadFolderBox" Width="240" VerticalAlignment="Center"
                             ToolTip="新建下载任务时默认使用此目录"/>
                    <Button Content="浏览…" Click="OnBrowseDownloadFolder" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="AutomaticBox" Content="自动选择连接数（推荐）"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="固定连接数" Width="110" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ConnectionsBox" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="同时下载任务数" Width="110" VerticalAlignment="Center"/>
                    <ComboBox x:Name="JobLimitBox" Width="100"/>
                    <TextBlock Text="个（其余排队）" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="#5B6573"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="全局限速" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="SpeedLimitBox" Width="100" VerticalAlignment="Center"/>
                    <TextBlock Text="KiB/s（0 = 不限）" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="#5B6573"/>
                </StackPanel>
                <CheckBox x:Name="DynamicSegmentsBox" Content="动态段拆分（实验）"
                          Margin="0,14,0,0"/>
                <CheckBox x:Name="SparseFileBox" Content="稀疏工作文件（实验）"
                          Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="ffmpeg 路径" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="FfmpegPathBox" Width="240" VerticalAlignment="Center"
                             ToolTip="留空则从 PATH 查找；仅合并分离的音视频轨时需要"/>
                    <Button Content="浏览…" Click="OnBrowseFfmpeg" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ProxyBox" Content="使用系统代理" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="窗口行为" Margin="0,22,0,10" FontWeight="SemiBold"/>
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <CheckBox x:Name="CloseToTrayBox" Content="关闭主窗口时最小化到托盘"/>
                <CheckBox x:Name="StartMinimizedBox" Content="启动后静默进入托盘" Margin="0,12,0,0"/>
                <CheckBox x:Name="LaunchAtStartupBox" Content="登录 Windows 后自动启动" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="5" Text="快捷方式" Margin="0,22,0,10" FontWeight="SemiBold"/>
        <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal">
                <Button Content="创建桌面快捷方式" Click="OnCreateDesktopShortcut" Margin="0,0,8,0"/>
                <Button Content="添加到开始菜单" Click="OnCreateStartMenuShortcut"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
