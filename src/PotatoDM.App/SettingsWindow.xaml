<Window x:Class="PotatoDM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 土豆下载器" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Height="520"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="下载行为" Margin="0,22,0,10" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="默认下载目录" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="DownloadFolderBox" Width="256" VerticalAlignment="Center"
                                     ToolTip="新建下载任务时默认使用此目录"
                                     AutomationProperties.Name="默认下载目录"/>
                            <Button Content="浏览…(_B)" Click="OnBrowseDownloadFolder" Margin="8,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutomaticBox" Content="自动选择连接数（推荐）"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="固定连接数" Width="110" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ConnectionsBox" Width="100" AutomationProperties.Name="固定连接数"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="同时下载任务数" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="JobLimitBox" Width="100" AutomationProperties.Name="同时下载任务数"/>
                            <TextBlock Text="个（其余排队）" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="每任务最大连接数" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PerJobLimitBox" Width="100"
                                      AutomationProperties.Name="每任务最大连接数"
                                      ToolTip="单个任务同时建立的连接上限，与「连接数」取较小者。这是单任务上限，不是整个程序的连接总数。"/>
                            <TextBlock Text="条（单任务上限）" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="全局限速" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpeedLimitBox" Width="100" VerticalAlignment="Center"
                                     AutomationProperties.Name="全局限速"/>
                            <TextBlock Text="KiB/s（0 = 不限）" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="DynamicSegmentsBox" Content="动态段拆分（实验）" Margin="0,14,0,0"/>
                        <CheckBox x:Name="SparseFileBox" Content="稀疏工作文件（实验）" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="ffmpeg 路径" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="FfmpegPathBox" Width="256" VerticalAlignment="Center"
                                     ToolTip="留空则从 PATH 查找；仅合并分离的音视频轨时需要"
                                     AutomationProperties.Name="ffmpeg 路径"/>
                            <Button Content="浏览…(_B)" Click="OnBrowseFfmpeg" Margin="8,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ProxyBox" Content="使用系统代理" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="窗口行为" Margin="0,22,0,10" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <CheckBox x:Name="CloseToTrayBox" Content="关闭主窗口时最小化到托盘"/>
                        <CheckBox x:Name="StartMinimizedBox" Content="启动后静默进入托盘" Margin="0,12,0,0"/>
                        <CheckBox x:Name="LaunchAtStartupBox" Content="登录 Windows 后自动启动" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="主题" Width="110" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeBox" Width="140" DisplayMemberPath="Value"
                                      SelectedValuePath="Key" AutomationProperties.Name="主题"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="快捷方式" Margin="0,22,0,10" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="创建桌面快捷方式(_D)" Click="OnCreateDesktopShortcut" Margin="0,0,8,0"/>
                        <Button Content="添加到开始菜单(_S)" Click="OnCreateStartMenuShortcut"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消(_C)" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="保存(_S)" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSave" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
