<Window x:Class="PotatoDM.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建下载"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="下载地址" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <TextBox x:Name="UrlBox"
                 Height="76"
                 Margin="0,6,0,4"
                 Padding="6,4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 PreviewKeyDown="OnUrlKeyDown"
                 AutomationProperties.Name="下载地址" />
        <TextBlock Text="支持 HTTP/HTTPS 与 magnet；每行一个，可一次添加多个。Ctrl+Enter 开始下载。"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource MutedBrush}" />

        <TextBlock Text="保存到" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <Grid Margin="0,6,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox"
                     Height="32"
                     Padding="6,4"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="保存位置" />
            <Button Grid.Column="1"
                    Content="浏览…(_B)"
                    Width="96"
                    Margin="8,0,0,0"
                    Click="OnBrowse" />
        </Grid>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="连接数"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <ComboBox x:Name="ConnectionsBox"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      Width="90"
                      Height="30"
                      Margin="12,0,0,0"
                      AutomationProperties.Name="连接数" />
            <TextBlock Text="自动模式会根据文件大小选择 1 / 4 / 8 / 16 连接。"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource StateErrorForegroundBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="取消(_C)"
                    IsCancel="True"
                    MinWidth="86"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button Content="开始下载(_D)"
                    IsDefault="True"
                    MinWidth="96"
                    Padding="14,6"
                    Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
