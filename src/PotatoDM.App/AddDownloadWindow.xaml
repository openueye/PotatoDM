<Window x:Class="PotatoDM.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建下载"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <StackPanel Margin="22">
        <TextBlock Text="下载地址" FontWeight="SemiBold" Foreground="#344054" />
        <TextBox x:Name="UrlBox"
                 Height="32"
                 Margin="0,6,0,4"
                 Padding="6,4"
                 VerticalContentAlignment="Center" />
        <TextBlock Text="支持 HTTP/HTTPS 与 magnet 磁力链接；视频清单会自动合并。"
                   Margin="0,0,0,14"
                   Foreground="#7A8494" />

        <TextBlock Text="保存到" FontWeight="SemiBold" Foreground="#344054" />
        <Grid Margin="0,6,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox"
                     Height="32"
                     Padding="6,4"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1"
                    Content="浏览…"
                    Width="86"
                    Margin="8,0,0,0"
                    Click="OnBrowse" />
        </Grid>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="连接数"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#344054" />
            <ComboBox x:Name="ConnectionsBox"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      Width="90"
                      Height="30"
                      Margin="12,0,0,0" />
            <TextBlock Text="自动模式会根据文件大小选择 1 / 4 / 8 / 16 连接。"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#7A8494" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Margin="0,14,0,0"
                   Foreground="#C62828"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="取消"
                    IsCancel="True"
                    MinWidth="86"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button Content="开始下载"
                    IsDefault="True"
                    MinWidth="96"
                    Padding="14,6"
                    Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
