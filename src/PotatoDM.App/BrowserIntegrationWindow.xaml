<Window x:Class="PotatoDM.App.BrowserIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览器集成"
        Height="740" Width="900"
        MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/PotatoDM.ico"
        Background="{StaticResource PageBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F1F0EC" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#201506" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,24">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="11" Background="#FFF0CF" Margin="0,0,12,0">
                    <TextBlock Text="↓" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandDarkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="浏览器接管"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="让 Chrome / Edge 的下载交给土豆下载器"
                               Style="{StaticResource Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="OverallBadge"
                    Grid.Column="1"
                    Style="{StaticResource Badge}"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="OverallBadgeText"
                           Style="{StaticResource BadgeText}"
                           FontSize="12" />
            </Border>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLineText"
                       Style="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="卸载集成" Click="OnUninstall" Margin="0,0,8,0" />
                <Button Content="安装 / 修复"
                        Click="OnInstall"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="112" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="宿主程序"
                                           Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="HostBadge"
                                        Style="{StaticResource Badge}"
                                        HorizontalAlignment="Right">
                                    <TextBlock x:Name="HostBadgeText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="浏览器接管所需的宿主与扩展目录"
                                       Style="{StaticResource Muted}"
                                       Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="扩展目录"
                                           Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="SourceBadge"
                                        Style="{StaticResource Badge}"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="SourceBadgeText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="扩展 ID"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Chrome 与 Edge 共用同一个扩展 ID"
                                       Style="{StaticResource Muted}"
                                       Margin="0,8,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExtensionIdBox"
                                         Style="{StaticResource PathBox}"
                                         ToolTip="安装后生成，也可在浏览器扩展页查看" />
                                <Button x:Name="CopyExtensionIdButton"
                                        Grid.Column="1"
                                        Content="复制"
                                        Style="{StaticResource SmallButton}"
                                        Margin="8,0,0,0"
                                        Click="OnCopyExtensionId" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="浏览器"
                                   Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chrome"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border x:Name="ChromeDetectedBadge"
                                        Style="{StaticResource Badge}">
                                    <TextBlock x:Name="ChromeDetectedText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                                <Border x:Name="ChromeRegisteredBadge"
                                        Style="{StaticResource Badge}"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="ChromeRegisteredText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="打开扩展页"
                                    Style="{StaticResource SmallButton}"
                                    Click="OnOpenChrome" />
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edge"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border x:Name="EdgeDetectedBadge"
                                        Style="{StaticResource Badge}">
                                    <TextBlock x:Name="EdgeDetectedText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                                <Border x:Name="EdgeRegisteredBadge"
                                        Style="{StaticResource Badge}"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="EdgeRegisteredText"
                                               Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="打开扩展页"
                                    Style="{StaticResource SmallButton}"
                                    Click="OnOpenEdge" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="加载扩展"
                                   Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="1"
                                           Style="{StaticResource StepNumberText}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource StepText}"
                                       Margin="10,1,0,0"
                                       Text="点击下方“安装 / 修复”，复制扩展并注册宿主。" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="2"
                                           Style="{StaticResource StepNumberText}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource StepText}"
                                       Margin="10,1,0,0"
                                       Text="在浏览器中打开扩展页，开启“开发者模式”。" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="3"
                                           Style="{StaticResource StepNumberText}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource StepText}"
                                       Margin="10,1,0,0"
                                       Text="在扩展页选择“加载已解压的扩展（程序）”，指向下方的扩展目录。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="位置"
                                       Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button Content="打开扩展目录"
                                    Style="{StaticResource SmallButton}"
                                    Click="OnOpenFolder"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Text="扩展目录"
                                   Style="{StaticResource Muted}"
                                   Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChromiumPathBox"
                                     Style="{StaticResource PathBox}" />
                            <Button x:Name="CopyChromiumPathButton"
                                    Grid.Column="1"
                                    Content="复制"
                                    Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0"
                                    Click="OnCopyChromiumPath" />
                        </Grid>

                        <TextBlock Text="宿主清单"
                                   Style="{StaticResource Muted}"
                                   Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManifestPathBox"
                                     Style="{StaticResource PathBox}" />
                            <Button x:Name="CopyManifestPathButton"
                                    Grid.Column="1"
                                    Content="复制"
                                    Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0"
                                    Click="OnCopyManifestPath" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
