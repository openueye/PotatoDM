{
  "manifest_version": 3,
  "name": "土豆下载器 - 浏览器接管",
  "version": "0.2.0",
  "description": "将浏览器下载交给土豆下载器，并发现页面中的可下载媒体资源。",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "土豆下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage",
    "tabs",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
