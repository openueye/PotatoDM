<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pin the ruleset to the SDK we target: "latest" would turn new rules in a
         future SDK into build failures without anyone choosing them. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>8.0</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Product>PotatoDM</Product>
    <Authors>PotatoDM contributors</Authors>
    <Copyright>Copyright (c) 2026 PotatoDM contributors</Copyright>
  </PropertyGroup>
</Project>
