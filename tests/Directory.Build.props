<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The analyzer gate covers shipped code. Test projects keep their own naming
         conventions (CA1707 alone would flag every snake_case test method) and have
         no public surface whose design rules we need to protect. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
